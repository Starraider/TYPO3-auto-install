page = PAGE
page {
  10 = PAGEVIEW
  10 {
    paths {
      0 = EXT:yyy_sitepackage/Resources/Private/PageView/
      10 = {$YyySitepackage.template_path}
    }

    dataProcessing {
      # makes content elements available as {content} in Fluid template
      10 = page-content
    }
  }
  shortcutIcon = {$YyySitepackage.favicon}
}
