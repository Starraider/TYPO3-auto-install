{
  "name": "typo3-auto-install",
  "version": "1.0.0",
  "private": true,
  "description": "A planned, interactive TYPO3 and DDEV project installer",
  "type": "module",
  "bin": {
    "typo3-auto-install": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run build && npm run test:run"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
